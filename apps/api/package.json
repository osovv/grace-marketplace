{
  "name": "@grace/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:local": "ENV_FILE=.env.local tsx watch src/server.ts",
    "dev:stage": "ENV_FILE=.env.stage tsx watch src/server.ts",
    "prebuild": "npm run prisma:generate",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "db:push": "set -a && source .env && set +a && prisma db push --schema prisma/schema.prisma",
    "db:push:local": "set -a && source .env.local && set +a && prisma db push --schema prisma/schema.prisma",
    "db:push:stage": "set -a && source .env.stage && set +a && prisma db push --schema prisma/schema.prisma",
    "prisma:migrate:sql": "prisma migrate diff --from-empty --to-schema-datamodel prisma/schema.prisma --script > prisma/migrations/0001_init.sql",
    "prisma:seed": "prisma db seed --schema prisma/schema.prisma",
    "pretest": "npm run prisma:generate",
    "test": "vitest run"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/sensible": "^6.0.3",
    "@prisma/client": "^6.0.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.0.0",
    "fastify-plugin": "^5.0.1",
    "pino": "^9.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "prisma": "^6.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
